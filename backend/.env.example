# ═══════════════════════════════════════════════════════════════════════════════
# WeatherGPT — Environment Configuration Example
# Copy this to .env and fill in your actual values.
# NEVER commit .env to git (it is in .gitignore).
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
DEMO_MODE=True

# ── Database ───────────────────────────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite:///./weathergpt.db
# Production PostgreSQL (uncomment and fill in):
# DATABASE_URL=postgresql://weathergpt:yourpassword@localhost:5432/weathergpt

# ── Security / JWT ─────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI / LLM ───────────────────────────────────────────────────────────────────
# Google Gemini:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter (Primary & Backup keys for high-availability):
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BACKUP_API_KEY=your_backup_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto

# ── Weather Data Provider ──────────────────────────────────────────────────────
# Optional — Open-Meteo is used as keyless primary source.
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Caching ────────────────────────────────────────────────────────────────────
# Optional Redis for shared cache across workers (leave blank for in-memory):
# REDIS_URL=redis://localhost:6379/0
WEATHER_CACHE_TTL_SECONDS=600
AI_CACHE_TTL_SECONDS=1800
