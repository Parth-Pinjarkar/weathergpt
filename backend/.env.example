PORT=8000
DEMO_MODE=false
DATABASE_URL=postgresql://username:password@ep-something.neon.tech/neondb?sslmode=require
WEATHER_PROVIDER=openmeteo

# CORS (Include your Vercel frontend URL, e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,https://weathergpt-ai.vercel.app

# Security
JWT_SECRET_KEY=generate_a_random_hex_key_here_32_bytes
JWT_EXPIRE_MINUTES=60
WEATHER_CACHE_TTL_SECONDS=600

# AI / LLM Keys (Optional - has rule-based and Open-Meteo fallback if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENWEATHER_API_KEY=
